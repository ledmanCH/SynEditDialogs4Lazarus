object frmDemo: TfrmDemo
  Left = 300
  Height = 520
  Top = 200
  Width = 760
  Caption = 'SynEdit dialogs demo'
  ClientHeight = 520
  ClientWidth = 760
  Position = poScreenCenter
  OnClose = FormClose
  OnCreate = FormCreate
  object pnlTop: TPanel
    Left = 0
    Height = 36
    Top = 0
    Width = 760
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 36
    ClientWidth = 760
    TabOrder = 0
    object btnOptions: TButton
      Left = 8
      Height = 25
      Top = 6
      Width = 120
      Caption = 'Options...'
      OnClick = btnOptionsClick
      TabOrder = 0
    end
    object btnColors: TButton
      Left = 136
      Height = 25
      Top = 6
      Width = 120
      Caption = 'Colors...'
      OnClick = btnColorsClick
      TabOrder = 1
    end
  end
  object SynEdit1: TSynEdit
    Left = 0
    Height = 280
    Top = 36
    Width = 760
    Align = alTop
    Font.Height = -13
    Font.Name = 'Courier New'
    Font.Pitch = fpFixed
    Font.Quality = fqNonAntialiased
    ParentColor = False
    ParentFont = False
    TabOrder = 1
    Highlighter = SynPasSyn1
  end
  object splEditors: TSplitter
    Cursor = crVSplit
    Left = 0
    Height = 5
    Top = 316
    Width = 760
    Align = alTop
    ResizeAnchor = akTop
  end
  object SynEdit2: TSynEdit
    Left = 0
    Height = 199
    Top = 321
    Width = 760
    Align = alClient
    Font.Height = -13
    Font.Name = 'Courier New'
    Font.Pitch = fpFixed
    Font.Quality = fqNonAntialiased
    ParentColor = False
    ParentFont = False
    TabOrder = 2
    Highlighter = SynSQLSyn1
  end
  object SynPasSyn1: TSynPasSyn
    Left = 600
    Top = 8
  end
  object SynSQLSyn1: TSynSQLSyn
    SQLDialect = sqlStandard
    Left = 640
    Top = 8
  end
  object pmColors: TPopupMenu
    Left = 680
    Top = 8
    object mnuColorPascal: TMenuItem
      Tag = 1
      Caption = 'Pascal'
      OnClick = mnuColorClick
    end
    object mnuColorSQL: TMenuItem
      Tag = 2
      Caption = 'SQL'
      OnClick = mnuColorClick
    end
  end
end
