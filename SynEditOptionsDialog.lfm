    object Options: TTabSheet
      Caption = 'Options'
      object gbOptions: TGroupBox
        Left = 8
        Top = 0
        Width = 330
        Height = 247
        Caption = 'Options'
        ParentShowHint = False
        ShowHint = True
        object ckAutoIndent: TCheckBox
          Left = 7
          Top = 0
          Width = 130
          Height = 17
          Caption = 'Auto indent'
          Hint = 'Will indent the caret on new lines with the same amount of leading white space as the preceding line'
        end
        object ckAutoSizeMaxWidth: TCheckBox
          Left = 7
          Top = 19
          Width = 130
          Height = 17
          Caption = 'Auto size scroll width'
          Hint = 'Automatically resizes the scroll width when inserting text'
        end
        object ckDragAndDropEditing: TCheckBox
          Left = 7
          Top = 38
          Width = 130
          Height = 17
          Caption = 'Drag and drop editing'
          Hint = 'Allows you to select a block of text and drag it within the document to another location'
        end
        object ckAltSetsColumnMode: TCheckBox
          Left = 7
          Top = 57
          Width = 130
          Height = 17
          Caption = 'Alt sets column mode'
          Hint = 'Holding down the Alt Key will put the selection mode into columnar format'
        end
        object ckKeepCaretX: TCheckBox
          Left = 7
          Top = 76
          Width = 130
          Height = 17
          Caption = 'Maintain caret column'
          Hint = 'When moving through lines the X position will always stay the same'
        end
        object ckWantTabs: TCheckBox
          Left = 7
          Top = 95
          Width = 130
          Height = 17
          Caption = 'Want tabs'
          Hint = 'Let the editor accept tab characters instead of going to the next control'
        end
        object ckSmartTabs: TCheckBox
          Left = 7
          Top = 114
          Width = 130
          Height = 17
          Caption = 'Smart tabs'
          Hint = 'When tabbing, the cursor will go to the next non-white space character of the previous line'
        end
        object ckSmartTabDelete: TCheckBox
          Left = 7
          Top = 133
          Width = 130
          Height = 17
          Caption = 'Smart tab delete'
          Hint = 'similar to Smart Tabs, but when you delete characters'
        end
        object ckEnhanceHomeKey: TCheckBox
          Left = 7
          Top = 152
          Width = 146
          Height = 17
          Caption = 'Enhance Home Key'
          Hint = 'enhances home key positioning, similar to visual studio'
        end
        object ckEnhanceEndKey: TCheckBox
          Left = 7
          Top = 171
          Width = 130
          Height = 17
          Caption = 'Enhance End Key'
          Hint = 'Enhances End key positioning: jumps to the last non-space char first'
        end
        object ckHideShowScrollbars: TCheckBox
          Left = 7
          Top = 190
          Width = 156
          Height = 17
          Caption = 'Hide scrollbars as necessary'
          Hint = 'if enabled, then the scrollbars will only show when necessary.  If you have ScrollPastEOL, then it the horizontal bar will always be there (it uses MaxLength instead)'
        end
        object ckDisableScrollArrows: TCheckBox
          Left = 7
          Top = 209
          Width = 130
          Height = 17
          Caption = 'Disable scroll arrows'
          Hint = 'Disables the scroll bar arrow buttons when you can''t scroll in that direction any more'
        end
        object ckHalfPageScroll: TCheckBox
          Left = 174
          Top = 0
          Width = 130
          Height = 17
          Caption = 'Half page scroll'
          Hint = 'When scrolling with page-up and page-down commands, only scroll a half page at a time'
        end
        object ckScrollByOneLess: TCheckBox
          Left = 174
          Top = 19
          Width = 130
          Height = 17
          Caption = 'Scroll by one less'
          Hint = 'Forces scrolling to be one less'
        end
        object ckScrollPastEOF: TCheckBox
          Left = 174
          Top = 38
          Width = 130
          Height = 17
          Caption = 'Scroll past end of file'
          Hint = 'Allows the cursor to go past the end of file marker'
        end
        object ckScrollPastEOL: TCheckBox
          Left = 174
          Top = 57
          Width = 130
          Height = 17
          Caption = 'Scroll past end of line'
          Hint = 'Allows the cursor to go past the last character into the white space at the end of a line'
        end
        object ckShowScrollHint: TCheckBox
          Left = 174
          Top = 76
          Width = 130
          Height = 17
          Caption = 'Show scroll hint'
          Hint = 'Shows a hint of the visible line numbers when scrolling vertically'
        end
        object ckScrollHintFollows: TCheckBox
          Left = 174
          Top = 95
          Width = 152
          Height = 17
          Caption = 'Scroll hint follows mouse'
          Hint = 'The scroll hint follows the mouse when scrolling vertically'
        end
        object ckTabIndent: TCheckBox
          Left = 174
          Top = 114
          Width = 130
          Height = 17
          Caption = 'Tab indent'
          Hint = 'Use tab for indention'
        end
        object ckTabsToSpaces: TCheckBox
          Left = 174
          Top = 133
          Width = 130
          Height = 17
          Caption = 'Tabs to spaces'
          Hint = 'Converts a tab character to the number of spaces in Tab Width'
        end
        object ckTrimTrailingSpaces: TCheckBox
          Left = 174
          Top = 152
          Width = 130
          Height = 17
          Caption = 'Trim trailing spaces'
          Hint = 'Spaces at the end of lines will be trimmed and not saved'
        end
        object ckGroupUndo: TCheckBox
          Left = 174
          Top = 171
          Width = 130
          Height = 17
          Caption = 'Group undo'
          Hint = 'When undoing/redoing actions, handle all continous changes of the same kind in one call instead undoing/redoing each command separately'
        end
        object ckRightMouseMoves: TCheckBox
          Left = 174
          Top = 190
          Width = 146
          Height = 17
          Caption = 'Right mouse moves cursor'
          Hint = 'When clicking with the right mouse for a popup menu, move the cursor to that location'
        end
        object ckShowSpecialChars: TCheckBox
          Left = 174
          Top = 209
          Width = 130
          Height = 17
          Caption = 'Show special chars'
          Hint = 'Shows linebreaks, spaces and tabs using special symbols'
        end
      end
